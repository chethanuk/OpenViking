{
  "_comment": [
    "Gemini Embedding 2 configuration for OpenViking.",
    "Set GOOGLE_API_KEY env var before starting the server.",
    "Dimensions: 128-3072 via MRL. Recommended: 768, 1536, 3072. Default: 3072.",
    "Non-symmetric mode (recommended for RAG): set query_param + document_param.",
    "Symmetric mode: set task_type only (omit query_param/document_param).",
    "All task_types: RETRIEVAL_QUERY, RETRIEVAL_DOCUMENT, SEMANTIC_SIMILARITY,",
    "  CLASSIFICATION, CLUSTERING, QUESTION_ANSWERING, FACT_VERIFICATION, CODE_RETRIEVAL_QUERY"
  ],
  "embedding": {
    "dense": {
      "model": "gemini-embedding-2-preview",
      "provider": "gemini",
      "api_key": "${GOOGLE_API_KEY}",
      "dimension": 1536,
      "query_param": "RETRIEVAL_QUERY",
      "document_param": "RETRIEVAL_DOCUMENT"
    }
  }
}
